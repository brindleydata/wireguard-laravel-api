APP_NAME="WireGuard API"
APP_VERSION="0.8"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
LOG_CHANNEL=stack

API_KEY=

# External service URL used to auto-detect the server's public IP.
IP_SERVICE=http://ifconfig.me/ip

# Public DNS name or IP address for client configs. Auto-detected via IP_SERVICE if not set.
WIREGUARD_HOSTNAME=

# Default DNS server for client configs. Can be overridden per interface.
WIREGUARD_DNS=8.8.8.8

# Default PersistentKeepalive (seconds) for client configs. Can be overridden per interface.
WIREGUARD_KEEPALIVE=25

# Default AllowedIPs for client configs (0.0.0.0/0 = route all traffic). Can be overridden per interface.
WIREGUARD_ALLOWED_IPS=0.0.0.0/0
