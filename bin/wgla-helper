#!/bin/bash
#
# wgla-helper: the one command the web server user may run as root.
#
# The app never gets a general-purpose root shell. Every privileged operation is one of the
# commands below, every argument is validated, and every wg-quick config is checked before it
# is written: only known keys, and the only hooks allowed are calls back into this helper. So a
# compromised web user can manage WireGuard links but can't run commands, read files or plant
# hooks as root.
#
# Install root-owned, outside the web-writable app directory (see `php artisan wg:help`), and
# reinstall after updating the app. Must stay compatible with macOS's bash 3.2.

set -euo pipefail
umask 077
IFS=$' \t\n'
# Bytes, whatever locale sudo hands over: character classes and ranges in the checks below then
# mean the same everywhere (under glibc's C.UTF-8, [[:cntrl:]] also matches U+2028 in a name)
export LC_ALL=C

VERSION=10
SELF=$0
MAX_SIZE=1048576

die() { echo "wgla-helper: $*" >&2; exit 1; }
# A config that isn't there is exit status 3, so the app can tell "no such link" from a failure
missing() { echo "wgla-helper: $*" >&2; exit 3; }

# ─── Environment ─────────────────────────────────────────────────────────────

if [ "$(id -u)" -eq 0 ]; then
    # As root, nothing comes from the caller's environment
    OS=$(uname -s)
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    if [ "$OS" = Darwin ]; then
        PATH=/opt/homebrew/bin:/opt/homebrew/sbin:$PATH
    fi
    WGLA_CONF_DIR='' WGLA_RUN_DIR='' TMPDIR=/tmp
    POLICY_FILE=/etc/wgla/policy.conf
else
    # Unprivileged runs can't do anything privileged; tests use them with stubs and temp dirs
    OS=${WGLA_OS:-$(uname -s)}
    POLICY_FILE=${WGLA_POLICY:-/etc/wgla/policy.conf}
fi

case "$OS" in
    Linux)
        CONF_DIR=${WGLA_CONF_DIR:-/etc/wireguard}
        RUN_DIR=${WGLA_RUN_DIR:-/var/run/wireguard}
        ;;
    Darwin)
        if [ -d /opt/homebrew ]; then default_conf=/opt/homebrew/etc/wireguard; else default_conf=/usr/local/etc/wireguard; fi
        CONF_DIR=${WGLA_CONF_DIR:-$default_conf}
        RUN_DIR=${WGLA_RUN_DIR:-/var/run/wireguard}
        ;;
    *) die "unsupported OS: $OS" ;;
esac
export PATH

# wg resolves a peer's Endpoint name when it sets it, and retries a name that doesn't resolve
# (yet) 15 times by default: for minutes, so the app's call would time out and leave wg running
# without it. A few tries, then fail. (Not at boot: systemd runs wg-quick there, not this.)
export WG_ENDPOINT_RESOLUTION_RETRIES=2

# ─── Validation ──────────────────────────────────────────────────────────────

re_name='^[a-zA-Z][a-zA-Z0-9_-]{0,14}$'
re_ifname='^[A-Za-z0-9_.-]{1,15}$'
re_key='^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$'
re_safe_key='^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$'
# No leading zeros: "08" would pass a numeric test, but $(( )) reads it as (invalid) octal
re_octet='(0|[1-9][0-9]{0,2})'
re_cidr4="^$re_octet\\.$re_octet\\.$re_octet\\.$re_octet/(0|[1-9][0-9]?)\$"
re_cidr6='^[0-9a-fA-F:]{2,39}/([0-9]{1,3})$'
re_ips='^[0-9A-Fa-f.:/]+(, ?[0-9A-Fa-f.:/]+)*$'
re_dns='^[A-Za-z0-9.:-]+(, ?[A-Za-z0-9.:-]+)*$'
re_number='^[0-9]{1,5}$'
# Where the server connects to a peer: host:port, an IPv6 address in brackets
re_endpoint='^([A-Za-z0-9.-]+|\[[0-9A-Fa-f:]+\]):[0-9]{1,5}$'
# Where a link's clients connect (its metadata): a host, or host:port
re_link_endpoint='^([A-Za-z0-9.-]+|\[[0-9A-Fa-f:]+\])(:[0-9]{1,5})?$'

valid_cidr4() {
    [[ $1 =~ $re_cidr4 ]] || return 1
    [ "${BASH_REMATCH[1]}" -le 255 ] && [ "${BASH_REMATCH[2]}" -le 255 ] &&
        [ "${BASH_REMATCH[3]}" -le 255 ] && [ "${BASH_REMATCH[4]}" -le 255 ] && [ "${BASH_REMATCH[5]}" -le 32 ]
}
# IPv6 address with prefix: hex and colons only (nft and pf mask host bits themselves), one ::
valid_cidr6() {
    [[ $1 =~ $re_cidr6 ]] && [ "${BASH_REMATCH[1]}" -le 128 ] || return 1
    case "$1" in *:::* | *::*::*) return 1 ;; esac
}
# A link's Address line: IPv4, or IPv4 then IPv6
valid_link_address() {
    local re='^([^,]+), ([^,]+)$' v4 v6
    if [[ $1 =~ $re ]]; then
        # Copied first: each check runs its own regex, which replaces BASH_REMATCH
        v4=${BASH_REMATCH[1]} v6=${BASH_REMATCH[2]}
        valid_cidr4 "$v4" && valid_cidr6 "$v6"
    else
        valid_cidr4 "$1"
    fi
}
# A link's destinations (where traffic out of its tunnel may go): networks of either family, each
# with its mask, as the app writes them. Not everything (/0): that is a link without destinations.
# They end up in firewall rules, so nothing but addresses passes.
valid_destinations() {
    local entry re='/[1-9][0-9]{0,2}$'
    [[ $1 =~ $re_ips ]] || return 1
    for entry in $(echo "$1" | tr ',' ' '); do
        [[ $entry =~ $re ]] || return 1
        case "$entry" in
            *:*) valid_cidr6 "$entry" && ip6_expand "${entry%/*}" || return 1 ;;
            *) valid_cidr4 "$entry" || return 1 ;;
        esac
    done
}
valid_port() { [[ $1 =~ $re_number ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_keepalive() { [[ $1 =~ $re_number ]] && [ "$1" -le 65535 ]; }
valid_mtu() { [[ $1 =~ $re_number ]] && [ "$1" -ge 576 ] && [ "$1" -le 65535 ]; }
valid_bool() { [ "$1" = true ] || [ "$1" = false ]; }

name_arg()    { [[ $1 =~ $re_name ]] || die "invalid link name: $1"; }
iface_arg()   { [[ $1 =~ $re_name ]] || die "invalid interface name: $1"; }
key_arg()     { [[ $1 =~ $re_key ]] || die "invalid public key: $1"; }
safe_key_arg() { [[ $1 =~ $re_safe_key ]] || die "invalid client config key: $1"; }
ips_arg()     { [[ $1 =~ $re_ips ]] || die "invalid allowed IPs: $1"; }
args() { [ "$1" -eq "$2" ] || die "'$3' takes $1 argument(s)"; }

# The only hooks a config may contain: calls back into this helper. On macOS wg-quick expands
# %i to the real utunN and %I to the link name; on Linux only %i exists (the link name).
hook() {
    if [ "$OS" = Darwin ]; then
        if [ "$1" = up ]; then echo "$SELF firewall-up %I %i"; else echo "$SELF firewall-down %I"; fi
    else
        if [ "$1" = up ]; then echo "$SELF firewall-up %i %i"; else echo "$SELF firewall-down %i"; fi
    fi
}

# Copy stdin to a private temp file, refusing anything over MAX_SIZE
read_input() {
    local tmp=$1
    head -c $((MAX_SIZE + 1)) > "$tmp"
    [ "$(wc -c < "$tmp")" -le "$MAX_SIZE" ] || die "input larger than $MAX_SIZE bytes"
}

validate_meta() {
    local line=$1 re='^# ([a-z][a-z0-9_]*) = (.+)$' key value
    [[ $line =~ $re ]] || die "malformed metadata comment: $line"
    key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    # A link's own route settings, for its peers' AllowedIPs further down (check_routes)
    case "$key" in
        allow_default_route) LINK_DEFAULT_ROUTE=$value ;;
        allow_own_networks) LINK_OWN_NETWORKS=$value ;;
    esac
    case "$key" in
        address) valid_cidr4 "$value" ;;
        address6) valid_cidr6 "$value" ;;
        ifout) [[ $value =~ $re_ifname ]] ;;
        endpoint) [[ $value =~ $re_link_endpoint ]] ;;
        forward | nat | inbound | allow_default_route | allow_own_networks) valid_bool "$value" ;;
        format) [[ $value =~ ^[0-9]{1,3}$ ]] ;;
        dns) [[ $value =~ $re_dns ]] ;;
        keepalive) valid_keepalive "$value" ;;
        allowed_ips) [[ $value =~ $re_ips ]] ;;
        destinations) valid_destinations "$value" ;;
        *) false ;;
    esac || die "metadata not allowed: $line"
}

# A peer's label (a comment): any characters but control ones, at most 256 bytes
valid_peer_name() { [ -n "$1" ] && [ "${#1}" -le 256 ] && [[ $1 != *[[:cntrl:]]* ]]; }

# A wg-quick config may only contain what the app writes. A disabled peer is a commented-out
# [Peer] section (wg-quick ignores it); peers may carry a "# name = …" label and client settings
# of their own ("# dns = …", "# keepalive = …", "# allowed_ips = …"), checked like the link's.
validate_conf() {
    local section='' line key value re='^([A-Za-z]+) = (.+)$' disabled='^# ([A-Za-z]+ = .+)$'
    LINK_DEFAULT_ROUTE=false LINK_OWN_NETWORKS=false
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '') continue ;;
            '[Interface]')
                [ -z "$section" ] || die "[Interface] must come first, once"
                section=interface
                continue
                ;;
            '[Peer]' | '# [Peer] disabled')
                [ -n "$section" ] || die "[Peer] before [Interface]"
                if [ "$line" = '[Peer]' ]; then section=peer; else section=disabled; fi
                continue
                ;;
            '# name = '*)
                if [ "$section" = peer ] || [ "$section" = disabled ]; then
                    valid_peer_name "${line#'# name = '}" || die "invalid peer name: $line"
                    continue
                fi
                ;;
            '# dns = '* | '# keepalive = '* | '# allowed_ips = '*)
                if [ "$section" = peer ] || [ "$section" = disabled ]; then
                    validate_meta "$line"
                    continue
                fi
                ;;
        esac
        if [ "$section" = disabled ]; then
            # The disabled peer's own lines, checked like a live peer's
            [[ $line =~ $disabled ]] || die "malformed line in a disabled peer: $line"
            line=${BASH_REMATCH[1]}
        elif [[ $line == '#'* ]]; then
            [ -z "$section" ] || die "comments are only allowed before [Interface]"
            validate_meta "$line"
            continue
        fi

        [[ $line =~ $re ]] || die "malformed line: $line"
        key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
        case "$section:$key" in
            interface:Address) valid_link_address "$value" ;;
            interface:PrivateKey) [[ $value =~ $re_key ]] ;;
            interface:ListenPort) valid_port "$value" ;;
            interface:MTU) valid_mtu "$value" ;;
            interface:PostUp) [ "$value" = "$(hook up)" ] || die "PostUp must be exactly: $(hook up)" ;;
            interface:PostDown) [ "$value" = "$(hook down)" ] || die "PostDown must be exactly: $(hook down)" ;;
            peer:PublicKey | peer:PresharedKey | disabled:PublicKey | disabled:PresharedKey) [[ $value =~ $re_key ]] ;;
            # A disabled peer's too: it goes on the interface as it is when it's enabled
            peer:AllowedIPs | disabled:AllowedIPs) [[ $value =~ $re_ips ]] && check_routes "$value" ;;
            peer:Endpoint | disabled:Endpoint) [[ $value =~ $re_endpoint ]] ;;
            peer:PersistentKeepalive | disabled:PersistentKeepalive) valid_keepalive "$value" ;;
            *) false ;;
        esac || die "not allowed in a link config: $line"
    done < "$1"

    [ -n "$section" ] || die "missing [Interface]"
}

# A peer for `wg addconf`: [Peer] sections with keys, allowed IPs, and where to connect to it.
# Its routes are checked against the settings of the link it goes to (link_settings()).
validate_peer() {
    local line key value re='^([A-Za-z]+) = (.+)$'
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in '' | '[Peer]') continue ;; esac
        [[ $line =~ $re ]] || die "malformed line: $line"
        key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
        case "$key" in
            PublicKey | PresharedKey) [[ $value =~ $re_key ]] ;;
            AllowedIPs) [[ $value =~ $re_ips ]] && check_routes "$value" ;;
            Endpoint) [[ $value =~ $re_endpoint ]] ;;
            PersistentKeepalive) valid_keepalive "$value" ;;
            *) false ;;
        esac || die "not allowed in a peer: $line"
    done < "$1"
}

# ─── Route policy ────────────────────────────────────────────────────────────
#
# What peers may route is the server's to say first: a default route (/0) sends the server's own
# traffic to a peer, and a network that holds one of its own addresses or its gateway cuts it off
# from its network. Both need the server's policy (POLICY_FILE, root's, written by wg:install;
# missing: neither) and the link's own setting (`# allow_default_route = true`, written by the
# app). So a compromised web user, who can write link configs, still can't lift the server's.

LINK_DEFAULT_ROUTE=false LINK_OWN_NETWORKS=false

policy_allows() { [ -f "$POLICY_FILE" ] && grep -qx -- "$1=true" "$POLICY_FILE"; }

# Every entry of an AllowedIPs list, against the policy and the current link's settings
check_routes() {
    local entry own
    for entry in $(echo "$1" | tr ',' ' '); do
        case "$entry" in
            */0)
                if [ "$LINK_DEFAULT_ROUTE" != true ] || ! policy_allows allow_default_route; then
                    die "a peer may not route $entry here, a default route: see allow_default_route (the link's, and wg:install's for the server)"
                fi
                ;;
            *)
                own_addresses
                while IFS= read -r own; do
                    if [ -n "$own" ] && cidr_holds "$entry" "$own"; then
                        if [ "$LINK_OWN_NETWORKS" != true ] || ! policy_allows allow_own_networks; then
                            die "a peer may not route $entry here, which holds $own, an address of this server's own: see allow_own_networks (the link's, and wg:install's for the server)"
                        fi
                        break
                    fi
                done <<< "$OWN"
                ;;
        esac
    done
}

# The route settings of the link that runs as interface $1, from its config (no config: neither)
link_settings() {
    local link conf
    link=$(link_of_iface "$1")
    LINK_DEFAULT_ROUTE=false LINK_OWN_NETWORKS=false
    if [[ $link =~ $re_name ]] && conf=$(conf_file "$link") && [ -f "$conf" ]; then
        if [ "$(meta "$conf" allow_default_route)" = true ]; then LINK_DEFAULT_ROUTE=true; fi
        if [ "$(meta "$conf" allow_own_networks)" = true ]; then LINK_OWN_NETWORKS=true; fi
    fi
}

# The link of an OS interface: the same name on Linux, the one wg-quick recorded for a utunN on macOS
link_of_iface() {
    local file
    if [ "$OS" != Darwin ]; then echo "$1"; return; fi
    for file in "$RUN_DIR"/*.name; do
        if [ -e "$file" ] && [ "$(head -n 1 "$file")" = "$1" ]; then basename "$file" .name; return; fi
    done
}

# The server's own addresses (its interfaces') and gateway, one per line: read once, when needed
OWN='' OWN_READ=false
own_addresses() {
    [ "$OWN_READ" = false ] || return 0
    if [ "$OS" = Darwin ]; then
        OWN=$(ifconfig -a < /dev/null | sed -n 's/^[[:space:]]*inet6\{0,1\} \([0-9A-Fa-f.:]*\).*/\1/p') || die "can't read this server's addresses"
        OWN="$OWN"$'\n'$(route -n get default < /dev/null 2> /dev/null | sed -n 's/^[[:space:]]*gateway: \([0-9A-Fa-f.:]*\).*/\1/p' || true)
    else
        OWN=$(ip -o address show < /dev/null | sed -n 's/.* inet6\{0,1\} \([0-9A-Fa-f.:]*\)\/.*/\1/p') || die "can't read this server's addresses"
        OWN="$OWN"$'\n'$(ip route show default < /dev/null 2> /dev/null | sed -n 's/.* via \([0-9A-Fa-f.:]*\).*/\1/p' || true)
    fi
    OWN_READ=true
}

# Whether CIDR $1 (or a bare address) holds address $2. Addresses of different families never do.
cidr_holds() {
    local net=${1%/*} bits='' a b
    case "$1" in */*) bits=${1##*/} ;; esac
    case "$net" in
        *:*)
            # IPv6 (with an IPv4 address at its end, too): only an IPv6 address
            case "$2" in *:*) ;; *) return 1 ;; esac
            [[ ${bits:-128} =~ ^[0-9]{1,3}$ ]] && [ "${bits:-128}" -le 128 ] || return 1
            a=$(ip6_hex "$net") && b=$(ip6_hex "$2") || return 1
            hex_prefix_equal "$a" "$b" "${bits:-128}"
            ;;
        *)
            case "$2" in *:*) return 1 ;; esac
            valid_cidr4 "$net/${bits:-32}" && valid_cidr4 "$2/32" || return 1
            a=$(ip4_int "$net") b=$(ip4_int "$2")
            [ $(((a ^ b) >> (32 - ${bits:-32}))) -eq 0 ]
            ;;
    esac
}

# shellcheck disable=SC2086 # split on the dots on purpose
ip4_int() { local IFS=.; set -- $1; echo $((($1 << 24) | ($2 << 16) | ($3 << 8) | $4)); }

# An IPv6 address as 32 hex digits, or a failure for anything else. An IPv4 address at its end
# (::ffff:192.0.2.1, as inet_ntop writes it) is two groups.
ip6_hex() { ip6_expand "$1" && echo "$REPLY"; }

# The same, into REPLY: without a subshell, for where it runs once per rule (canon_net)
ip6_expand() {
    local addr=$1 head tail group hex out='' n=0 v4
    case "$addr" in
        *.*)
            v4=${addr##*:}
            valid_cidr4 "$v4/32" || return 1
            v4=$(((BASH_REMATCH[1] << 24) | (BASH_REMATCH[2] << 16) | (BASH_REMATCH[3] << 8) | BASH_REMATCH[4]))
            printf -v hex '%x:%x' $((v4 >> 16)) $((v4 & 65535))
            addr="${addr%:*}:$hex"
            ;;
    esac
    case "$addr" in
        *::*::* | *:::*) return 1 ;;
        *::*) head=${addr%%::*} tail=${addr#*::} ;;
        *) head=$addr tail='' ;;
    esac
    # shellcheck disable=SC2086 # split on the colons on purpose
    for group in ${head//:/ } ${tail//:/ }; do
        [[ $group =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
        n=$((n + 1))
    done
    case "$addr" in *::*) [ "$n" -le 7 ] || return 1 ;; *) [ "$n" -eq 8 ] || return 1 ;; esac
    # shellcheck disable=SC2086
    for group in ${head//:/ }; do printf -v hex '%04x' "0x$group"; out=$out$hex; done
    while [ "$n" -lt 8 ]; do out=${out}0000; n=$((n + 1)); done
    # shellcheck disable=SC2086
    for group in ${tail//:/ }; do printf -v hex '%04x' "0x$group"; out=$out$hex; done
    REPLY=$out
}

# Whether two 32-hex-digit addresses agree in their first $3 bits
hex_prefix_equal() {
    local nibbles=$(($3 / 4)) rest=$(($3 % 4)) mask
    [ "${1:0:$nibbles}" = "${2:0:$nibbles}" ] || return 1
    [ "$rest" -gt 0 ] || return 0
    mask=$(((0xF << (4 - rest)) & 0xF))
    [ $((16#${1:$nibbles:1} & mask)) -eq $((16#${2:$nibbles:1} & mask)) ]
}

# A network in one spelling, into REPLY: IPv4 as its network address and mask, IPv6 as 32 hex
# digits with the host bits cleared and its mask. A bare address is a host (/32, /128). nft and
# pfctl print a network their own way (host bits masked, a host without its mask, IPv6 shortened):
# so what they list is compared with what a config asks for as networks, not as text.
canon_net() {
    local net=${1%/*} bits='' nibbles rest hex digit
    case "$1" in */*) bits=${1##*/} ;; esac
    case "$net" in
        *:*)
            bits=${bits:-128}
            [[ $bits =~ ^(0|[1-9][0-9]{0,2})$ ]] && [ "$bits" -le 128 ] || return 1
            ip6_expand "$net" || return 1
            nibbles=$((bits / 4)) rest=$((bits % 4)) hex=${REPLY:0:$((bits / 4))}
            if [ "$rest" -gt 0 ]; then
                printf -v digit '%x' $((16#${REPLY:$nibbles:1} & (0xF << (4 - rest)) & 0xF))
                hex=$hex$digit
            fi
            while [ "${#hex}" -lt 32 ]; do hex=${hex}0; done
            REPLY="$hex/$bits"
            ;;
        *)
            valid_cidr4 "$net/${bits:-32}" || return 1
            bits=${BASH_REMATCH[5]}
            net=$(((BASH_REMATCH[1] << 24) | (BASH_REMATCH[2] << 16) | (BASH_REMATCH[3] << 8) | BASH_REMATCH[4]))
            net=$((net & ((0xFFFFFFFF << (32 - bits)) & 0xFFFFFFFF)))
            REPLY="$(((net >> 24) & 255)).$(((net >> 16) & 255)).$(((net >> 8) & 255)).$((net & 255))/$bits"
            ;;
    esac
}

# ─── Files ───────────────────────────────────────────────────────────────────

TMP=''
cleanup() { if [ -n "$TMP" ]; then rm -f "$TMP"; fi; }
trap cleanup EXIT

# Validate stdin with $2 (a function or `true`), then move it into place atomically
install_input() {
    local target=$1 check=$2 dir
    dir=$(dirname "$target")
    mkdir -p "$dir"
    TMP=$(mktemp "$dir/.wgla.XXXXXX")
    read_input "$TMP"
    $check "$TMP"
    chmod 600 "$TMP"
    mv -f "$TMP" "$target"
    TMP=''
}

conf_file() { echo "$CONF_DIR/$1.conf"; }
client_file() { echo "$CONF_DIR/clients/$1/$2.conf"; }
# The config an adoption replaced, kept until its outcome is known. Hidden, and no .conf: neither
# wg-quick nor conf-list takes it for a link.
adopted_file() { echo "$CONF_DIR/.$1.conf.before-adopt"; }

# The public keys of a config's peers, one per line: the enabled ones and the disabled (commented) ones
conf_pubkeys() { sed -n 's|^[[:space:]]*#\{0,1\}[[:space:]]*PublicKey[[:space:]]*=[[:space:]]*\([A-Za-z0-9+/=]*\)[[:space:]]*$|\1|p' "$1"; }

# The private keys an API before this one left in a link's client directory: whole client configs
# under any name (it used the peer's address), where the app's own are named by public key and
# hold the key alone. Each is told by the public key it belongs to, which is all that is printed:
#   list:   "legacy <public key>" for every such file
#   import: stores the key the app's way for each that is a peer in the link's config now and has
#           none stored yet, and prints those public keys. The old files stay as they are.
legacy_keys() {
    local link=$1 mode=$2 dir="$CONF_DIR/clients/$1" file name line key pub safe n peers='' nl=$'\n'
    # (As wg-quick reads a config: the key name in any case, a comment after the value)
    local re_line='^[[:space:]]*[Pp][Rr][Ii][Vv][Aa][Tt][Ee][Kk][Ee][Yy][[:space:]]*=[[:space:]]*([A-Za-z0-9+/=]+)[[:space:]]*(#.*)?$'
    [ -d "$dir" ] || return 0
    if [ "$mode" = import ]; then peers=$(conf_pubkeys "$(conf_file "$link")"); fi

    for file in "$dir"/*.conf; do
        if [ ! -f "$file" ] || [ -L "$file" ]; then continue; fi
        name=${file##*/}
        name=${name%.conf}
        if [[ $name =~ $re_safe_key ]]; then continue; fi
        # Its first PrivateKey line, near the top (a client config is a dozen lines)
        key='' n=0
        while IFS= read -r line || [ -n "$line" ]; do
            n=$((n + 1))
            if [ "$n" -gt 100 ]; then break; fi
            if [[ $line =~ $re_line ]]; then key=${BASH_REMATCH[1]}; break; fi
        done < "$file"
        if ! [[ $key =~ $re_key ]]; then continue; fi
        # (On stdin: a key is never on a command line)
        pub=$(printf '%s\n' "$key" | wg pubkey 2> /dev/null) || continue
        if ! [[ $pub =~ $re_key ]]; then continue; fi

        if [ "$mode" = import ]; then
            case "$nl$peers$nl" in *"$nl$pub$nl"*) ;; *) continue ;; esac
            safe=${pub//+/-}
            safe=${safe//\//_}
            safe=${safe%=}
            if [ -e "$dir/$safe.conf" ]; then continue; fi
            TMP=$(mktemp "$dir/.wgla.XXXXXX")
            printf '%s\n' "# This peer's private key, taken over from the client config an older API kept ($name.conf)." "PrivateKey = $key" > "$TMP"
            chmod 600 "$TMP"
            mv -f "$TMP" "$dir/$safe.conf"
            TMP=''
            echo "$pub"
        else
            echo "legacy $pub"
        fi
    done
}

# Metadata value from a link config (validated again before use)
meta() { sed -n "s/^# $2 = //p" "$1" | head -n 1; }

network_of() {
    valid_cidr4 "$1" || die "invalid address: $1"
    local a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]} c=${BASH_REMATCH[3]} d=${BASH_REMATCH[4]} mask=${BASH_REMATCH[5]}
    local ip=$(((a << 24) | (b << 16) | (c << 8) | d))
    local net=$((ip & ((0xFFFFFFFF << (32 - mask)) & 0xFFFFFFFF)))
    echo "$(((net >> 24) & 255)).$(((net >> 16) & 255)).$(((net >> 8) & 255)).$((net & 255))/$mask"
}

# ─── Firewall ────────────────────────────────────────────────────────────────
#
# Rules come from the link's saved config, so the PostUp hook and live updates install the
# same thing. Linux: one nftables table per link (inet wg_<link>). macOS: pf anchor wg/<link>.
#
# A link's `destinations` are the only networks traffic out of its tunnel is forwarded to, and the
# only ones its NAT covers: its peers hold their own keys and can route anything into the tunnel,
# so what the link is for is enforced here. They hold with or without `forward` (which only says
# whether the app opens forwarding where something else drops it, and what may come in). Without
# destinations a link reaches anywhere.

firewall_state() {
    local conf entry
    conf=$(conf_file "$1")
    [ -f "$conf" ] || die "no config for link $1"
    FORWARD=$(meta "$conf" forward) NAT=$(meta "$conf" nat) IFOUT=$(meta "$conf" ifout) ADDRESS=$(meta "$conf" address)
    ADDRESS6=$(meta "$conf" address6) INBOUND=$(meta "$conf" inbound) DESTINATIONS=$(meta "$conf" destinations)
    if ! valid_bool "${FORWARD:-false}" || ! valid_bool "${NAT:-false}" || ! valid_bool "${INBOUND:-false}"; then die "invalid forward/nat/inbound in $conf"; fi
    if [ "${NAT:-false}" = true ]; then
        [[ $IFOUT =~ $re_ifname ]] || die "invalid ifout in $conf"
    fi
    # The link's subnet and prefix: what NAT masquerades, what macOS lets in replies-only
    if [ "${NAT:-false}" = true ] || [ "${FORWARD:-false}" = true ]; then
        NETWORK=$(network_of "$ADDRESS")
        if [ -n "$ADDRESS6" ]; then valid_cidr6 "$ADDRESS6" || die "invalid address6 in $conf"; fi
    fi
    # Its destinations, per family (space-separated: they go into one rule each)
    DEST4='' DEST6=''
    if [ -n "$DESTINATIONS" ]; then
        valid_destinations "$DESTINATIONS" || die "invalid destinations in $conf"
        for entry in $(echo "$DESTINATIONS" | tr ',' ' '); do
            case "$entry" in *:*) DEST6="$DEST6 $entry" ;; *) DEST4="$DEST4 $entry" ;; esac
        done
    fi
}

# Whether the link's config asks for any rules at all
has_rules() { [ "${FORWARD:-false}" = true ] || [ "${NAT:-false}" = true ] || [ -n "$DESTINATIONS" ]; }

# The rules a function prints one per line, as one line: "rule; rule; " (nft)
joined() {
    local rule out=''
    while IFS= read -r rule; do
        if [ -n "$rule" ]; then out="$out$rule; "; fi
    done <<< "$("$@")"
    printf '%s' "$out"
}

# Firewalls driven by iptables (Docker, ufw) drop forwarded traffic in their own FORWARD
# chain, which an accept in our nftables table can't override. Add tagged accepts there too,
# for IPv4 (iptables) and IPv6 (ip6tables).
iptables_forward() {
    local tool
    for tool in iptables ip6tables; do
        xtables_forward "$tool" "$@" || return 1
    done
}

xtables_forward() {
    local iptables=$1 link=$2 iface=$3 enable=$4 inbound=$5 listing rule ours
    command -v "$iptables" > /dev/null 2>&1 || return 0
    listing=$("$iptables" -S FORWARD 2> /dev/null) || return 0

    # Remove our previous rules. They're rebuilt from their parts rather than re-using the listed
    # line: iptables -S quotes the comment ("wgla:wg0"), and listing text is never evaluated.
    ours=$(xtables_ours "$link")
    while IFS= read -r rule; do
        if [[ $rule =~ $ours ]]; then
            if [ -n "${BASH_REMATCH[3]}" ]; then
                "$iptables" -D FORWARD "-${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "wgla:$link" -j ACCEPT || return 1
            else
                "$iptables" -D FORWARD "-${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" -m comment --comment "wgla:$link" -j ACCEPT || return 1
            fi
        fi
    done <<< "$listing"

    [ "$enable" = true ] || return 0
    # Nothing in this table drops forwarded traffic: leave it alone
    [ "$("$iptables" -S FORWARD)" != '-P FORWARD ACCEPT' ] || return 0
    # Into the tunnel only replies to what peers started, unless the link takes connections in
    if [ "$inbound" = true ]; then
        "$iptables" -I FORWARD 1 -o "$iface" -m comment --comment "wgla:$link" -j ACCEPT || return 1
    else
        "$iptables" -I FORWARD 1 -o "$iface" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "wgla:$link" -j ACCEPT || return 1
    fi
    "$iptables" -I FORWARD 1 -i "$iface" -m comment --comment "wgla:$link" -j ACCEPT || return 1
}

# One of our accepts for a link in an `iptables -S FORWARD` listing: its own comment exactly
# (wgla:wg1 is not wgla:wg10), with the direction, the interface and the replies-only match as
# captures
xtables_ours() { echo "^-A FORWARD -([io]) ([^ ]+)( -m conntrack --ctstate RELATED,ESTABLISHED)? -m comment --comment \"?wgla:$1\"? -j ACCEPT\$"; }

firewall_up_linux() {
    local link=$1 iface=$2 table="wg_$1"
    {
        # Creating then deleting makes the replace atomic and work whether or not it exists
        echo "table inet $table"
        echo "delete table inet $table"
        if has_rules; then
            echo "table inet $table {"
            if [ "${FORWARD:-false}" = true ] || [ -n "$DESTINATIONS" ]; then
                echo "    chain forward { type filter hook forward priority 0; $(joined forward_out "$iface")$(joined forward_in "$iface")}"
            fi
            if [ "${NAT:-false}" = true ]; then
                echo "    chain postrouting { type nat hook postrouting priority 100; $(joined nat_rules)}"
            fi
            echo "}"
        fi
    } | nft -f - || return 1
    # (Explicit returns: firewall-repair runs this where `set -e` doesn't apply)
    iptables_forward "$link" "$iface" "${FORWARD:-false}" "${INBOUND:-false}"
}

# The nft rules for traffic out of the tunnel, one per line: all of it with `forward`, or, for a
# link with destinations, only what goes to them: a rule each, and the rest dropped (a drop here is
# final, whatever another table accepts). Replies to what came in for its peers still go out: only
# what a peer starts is held to the destinations. nft lists each network its own way (canon_net).
forward_out() {
    local entry
    if [ -z "$DESTINATIONS" ]; then
        if [ "${FORWARD:-false}" = true ]; then echo "iifname \"$1\" accept"; fi
        return
    fi
    echo "iifname \"$1\" ct state established,related accept"
    for entry in $DEST4; do echo "iifname \"$1\" ip daddr $entry accept"; done
    for entry in $DEST6; do echo "iifname \"$1\" ip6 daddr $entry accept"; done
    echo "iifname \"$1\" drop"
}

# The nft rules for traffic into the tunnel, one per line as `nft list` prints them: only replies
# to what peers started, the rest dropped (the chain's policy accepts: without the drop, nothing
# would be refused), unless the link takes connections that start outside (`inbound`,
# site-to-site). Peers' own traffic comes in on the interface and is accepted before these.
# Only with `forward`.
forward_in() {
    [ "${FORWARD:-false}" = true ] || return 0
    if [ "${INBOUND:-false}" = true ]; then
        echo "oifname \"$1\" accept"
    else
        echo "oifname \"$1\" ct state established,related accept"
        echo "oifname \"$1\" drop"
    fi
}

# The nft rules that masquerade the link's subnet (and prefix) out of its ifout, one per line: to
# anywhere, or one per destination of that family
nat_rules() {
    local entry
    if [ -z "$DESTINATIONS" ]; then
        echo "ip saddr $NETWORK oifname \"$IFOUT\" masquerade"
        if [ -n "$ADDRESS6" ]; then echo "ip6 saddr $ADDRESS6 oifname \"$IFOUT\" masquerade"; fi
        return
    fi
    for entry in $DEST4; do echo "ip saddr $NETWORK ip daddr $entry oifname \"$IFOUT\" masquerade"; done
    if [ -n "$ADDRESS6" ]; then
        for entry in $DEST6; do echo "ip6 saddr $ADDRESS6 ip6 daddr $entry oifname \"$IFOUT\" masquerade"; done
    fi
}

firewall_down_linux() {
    nft delete table inet "wg_$1" 2> /dev/null || true
    iptables_forward "$1" '' false false
}

firewall_up_darwin() {
    local link=$1 iface=$2 rules='' nat
    # pf rejects a ruleset whose translation (nat) rules come after filter (pass) rules
    if [ "${NAT:-false}" = true ]; then
        nat=$(pf_nat)
        if [ -n "$nat" ]; then rules="$nat"$'\n'; fi
    fi
    if [ -n "$DESTINATIONS" ]; then
        rules="$rules$(pf_scope "$link" "$iface")"$'\n'
    elif [ "${FORWARD:-false}" = true ]; then
        rules="${rules}pass in on $iface all"$'\n'
    fi
    if [ "${FORWARD:-false}" = true ]; then
        if [ "${INBOUND:-false}" = true ]; then
            rules="${rules}pass out on $iface all"$'\n'
        else
            rules="$rules$(pf_replies_only "$link" "$iface")"$'\n'
        fi
    fi

    if [ -z "$rules" ]; then
        firewall_down_darwin "$link"
        return
    fi
    printf '%s' "$rules" | pfctl -a "wg/$link" -f - || return 1
    pfctl -e > /dev/null 2>&1 || true
}

firewall_down_darwin() { pfctl -a "wg/$1" -F all > /dev/null 2>&1 || true; }

# The pf rules that translate the link's subnet (and prefix) out of its ifout, one per line: to
# anywhere, or one per destination of that family
pf_nat() {
    local entry
    if [ -z "$DESTINATIONS" ]; then
        echo "nat on $IFOUT from $NETWORK to any -> ($IFOUT)"
        if [ -n "$ADDRESS6" ]; then echo "nat on $IFOUT inet6 from $ADDRESS6 to any -> ($IFOUT)"; fi
        return
    fi
    for entry in $DEST4; do echo "nat on $IFOUT from $NETWORK to $entry -> ($IFOUT)"; done
    if [ -n "$ADDRESS6" ]; then
        for entry in $DEST6; do echo "nat on $IFOUT inet6 from $ADDRESS6 to $entry -> ($IFOUT)"; done
    fi
}

# Out of the tunnel only to the link's destinations, on macOS, one rule per line. pf sees a
# forwarded packet twice, coming in and going out, and one for this machine itself only coming in.
# So what comes in from the tunnel is tagged, without state, and what is still tagged so when it
# leaves through any interface is dropped: it was on its way elsewhere. `quick`, as pf goes by the
# last rule that matches: a link that takes connections in has a `pass out on <utun> all` further
# down (this link's own, for what goes to another peer of it, or another link's). What goes to a
# destination gets another tag instead (a tag stays until one replaces it) and state, as before:
# a tag per destination, so pfctl's optimizer has no rules it could fold into one or leave out, and
# they are listed as they were loaded. Replies to what came in for a peer match the state that
# made, which pf checks before any rule. (Without `forward` nothing here makes that state: then a
# peer's replies to what started outside its destinations are dropped as well, unlike on Linux.)
pf_scope() {
    local link=$1 iface=$2 entry n=0
    echo "pass in on $iface all no state tag wgla_no_$link"
    for entry in $DEST4; do
        n=$((n + 1))
        echo "pass in on $iface inet from any to $entry tag wgla_to_${link}_$n"
    done
    for entry in $DEST6; do
        n=$((n + 1))
        echo "pass in on $iface inet6 from any to $entry tag wgla_to_${link}_$n"
    done
    echo "block drop out quick all tagged wgla_no_$link"
}

# Only replies into the tunnel on macOS, one rule per line as pfctl prints them. What comes in
# elsewhere for the link's addresses is tagged, without state, so pf looks at it again on its way
# out, where it is dropped. Replies to what peers started match the state `pass in on <utun>` made,
# which pf checks before any rule. The server's own traffic to peers never came in: not tagged.
# $3 = listed: as globs for `pfctl -s rules`, which prints the prefix with its host bits masked.
pf_replies_only() {
    local tag="wgla_in_$1" iface=$2 prefix=$ADDRESS6 network=$NETWORK
    if [ "${3:-}" = listed ]; then
        prefix="*:*/${ADDRESS6#*/}"
        # (and a /32, the subnet of a link that is one address, without its mask)
        network=${NETWORK%/32}
    fi
    echo "pass in on ! $iface inet from any to $network no state tag $tag"
    if [ -n "$ADDRESS6" ]; then echo "pass in on ! $iface inet6 from any to $prefix no state tag $tag"; fi
    echo "block drop out on $iface all tagged $tag"
}

firewall_up() { if [ "$OS" = Darwin ]; then firewall_up_darwin "$@"; else firewall_up_linux "$@"; fi; }

# Whether the rules firewall-up installs are there, as the link's config asks for them now: NAT for
# its subnet (and prefix) out of its current ifout, forwarding into the tunnel replies-only or not,
# and out of it to anywhere or to exactly its destinations: neither one missing nor one too many.
# Another tool can take them away (`nft -f` of a ruleset that starts with "flush ruleset", a
# firewall restart). Each rule is matched as a whole line of the listing, as the tool prints it
# (a /32, the subnet of a link that is one address, without its mask).
firewall_present() {
    local link=$1 iface=$2 rules rule
    has_rules || return 0

    if [ "$OS" = Darwin ]; then
        if [ "${NAT:-false}" = true ]; then
            rules=$(pfctl -a "wg/$link" -s nat 2> /dev/null) || return 1
            if [ -z "$DESTINATIONS" ]; then
                has_line "$rules" "nat on $IFOUT inet from ${NETWORK%/32} to any *" || return 1
                if [ -n "$ADDRESS6" ]; then has_line "$rules" "nat on $IFOUT inet6 from *:* to any *" || return 1; fi
            else
                has_line "$rules" "nat on $IFOUT inet* from * to any *" && return 1
                lists_exactly "$rules" "nat on $IFOUT inet from ${NETWORK%/32} to " " -> *" "$DEST4" || return 1
                if [ -n "$ADDRESS6" ]; then lists_exactly "$rules" "nat on $IFOUT inet6 from *:* to " " -> *" "$DEST6" || return 1; fi
            fi
        fi
        if [ "${FORWARD:-false}" = true ] || [ -n "$DESTINATIONS" ]; then
            rules=$(pfctl -a "wg/$link" -s rules 2> /dev/null) || return 1
            if [ -n "$DESTINATIONS" ]; then
                # Nothing passed in from the tunnel as it is, to anywhere
                has_line "$rules" "pass in on $iface all flags*" && return 1
                has_line "$rules" "pass in on $iface all keep state*" && return 1
                has_line "$rules" "pass in on $iface all no state tag wgla_no_$link" || return 1
                lists_exactly "$rules" "pass in on $iface inet from any to " " *tag wgla_to_${link}_*" "$DEST4" || return 1
                lists_exactly "$rules" "pass in on $iface inet6 from any to " " *tag wgla_to_${link}_*" "$DEST6" || return 1
                has_line "$rules" "block drop out quick all tagged wgla_no_$link" || return 1
            else
                has_line "$rules" "pass in on $iface all*" || return 1
                # (No destinations any more: nothing of them left that drops)
                has_line "$rules" "block drop out quick all tagged wgla_no_$link" && return 1
            fi
        fi
        if [ "${FORWARD:-false}" = true ]; then
            if [ "${INBOUND:-false}" = true ]; then
                has_line "$rules" "pass out on $iface all*" || return 1
            else
                has_line "$rules" "pass out on $iface all*" && return 1
                while IFS= read -r rule; do
                    has_line "$rules" "$rule" || return 1
                done <<< "$(pf_replies_only "$link" "$iface" listed)"
            fi
        fi
        return 0
    fi

    rules=$(nft list table inet "wg_$link" 2> /dev/null) || return 1
    if [ "${NAT:-false}" = true ]; then
        if [ -z "$DESTINATIONS" ]; then
            has_line "$rules" "ip saddr ${NETWORK%/32} oifname \"$IFOUT\" masquerade" || return 1
            # nft prints the prefix with the host bits masked: only its length is known here
            if [ -n "$ADDRESS6" ]; then has_line "$rules" "ip6 saddr *:*/${ADDRESS6#*/} oifname \"$IFOUT\" masquerade" || return 1; fi
        else
            # Nothing masqueraded to anywhere (no rule with only a source), and a rule for each
            # destination and no other
            lists_exactly "$rules" "ip saddr " " oifname \"*\" masquerade" '' || return 1
            lists_exactly "$rules" "ip6 saddr " " oifname \"*\" masquerade" '' || return 1
            lists_exactly "$rules" "ip saddr ${NETWORK%/32} ip daddr " " oifname \"$IFOUT\" masquerade" "$DEST4" || return 1
            if [ -n "$ADDRESS6" ]; then
                lists_exactly "$rules" "ip6 saddr *:*/${ADDRESS6#*/} ip6 daddr " " oifname \"$IFOUT\" masquerade" "$DEST6" || return 1
            fi
        fi
    fi
    if [ -n "$DESTINATIONS" ]; then
        # Out of the tunnel to its destinations and nowhere else
        has_line "$rules" "iifname \"$iface\" accept" && return 1
        has_line "$rules" "iifname \"$iface\" ct state established,related accept" || return 1
        lists_exactly "$rules" "iifname \"$iface\" ip daddr " " accept" "$DEST4" || return 1
        lists_exactly "$rules" "iifname \"$iface\" ip6 daddr " " accept" "$DEST6" || return 1
        has_line "$rules" "iifname \"$iface\" drop" || return 1
    elif [ "${FORWARD:-false}" = true ]; then
        has_line "$rules" "iifname \"$iface\" accept" || return 1
        # (No destinations any more: nothing of them left that drops)
        has_line "$rules" "iifname \"$iface\" drop" && return 1
    fi
    if [ "${FORWARD:-false}" = true ]; then
        while IFS= read -r rule; do has_line "$rules" "$rule" || return 1; done <<< "$(forward_in "$iface")"
        # And, where iptables drops forwarded traffic, our accepts there
        xtables_present iptables "$link" "$iface" || return 1
        xtables_present ip6tables "$link" "$iface" || return 1
    fi
}

# Whether the listing $1 has a rule for each of the networks $4, written between $2 and $3, and no
# such rule for any other network. ($2 and $3 are globs, built from validated values only.)
lists_exactly() {
    local line token listed='' wanted='' entry
    while IFS= read -r line; do
        line=${line#"${line%%[![:space:]]*}"}
        # shellcheck disable=SC2053,SC2295 # $2 and $3 are globs on purpose
        if [[ $line == $2*$3 ]]; then
            token=${line#$2}
            token=${token%%$3}
            # One of ours has exactly a network there: anything else between is another rule
            [[ $token =~ ^[0-9A-Fa-f.:/]+$ ]] || continue
            canon_net "$token" || return 1
            listed="$listed$REPLY"$'\n'
        fi
    done <<< "$1"
    for entry in $4; do
        canon_net "$entry" || return 1
        wanted="$wanted$REPLY"$'\n'
    done
    [ "$(printf '%s' "$listed" | sort)" = "$(printf '%s' "$wanted" | sort)" ]
}

# Whether a line of $1 (leading whitespace aside) matches the glob $2. The globs above are built
# from validated values only: addresses, interface names, digits.
has_line() {
    local line
    while IFS= read -r line; do
        line=${line#"${line%%[![:space:]]*}"}
        # shellcheck disable=SC2053 # $2 is a glob on purpose
        if [[ $line == $2 ]]; then return 0; fi
    done <<< "$1"
    return 1
}

# Our two accepts for a link's interface, each as firewall-up adds them now (replies-only or not)
xtables_present() {
    local iptables=$1 link=$2 iface=$3 listing rule ours in=0 out=0
    command -v "$iptables" > /dev/null 2>&1 || return 0
    listing=$("$iptables" -S FORWARD 2> /dev/null) || return 0
    [ "$listing" != '-P FORWARD ACCEPT' ] || return 0
    ours=$(xtables_ours "$link")
    while IFS= read -r rule; do
        if [[ $rule =~ $ours ]] && [ "${BASH_REMATCH[2]}" = "$iface" ]; then
            case "${BASH_REMATCH[1]}:${BASH_REMATCH[3]:+replies}:${INBOUND:-false}" in
                i::*) in=1 ;;
                o::true | o:replies:false) out=1 ;;
            esac
        fi
    done <<< "$listing"
    [ "$in" = 1 ] && [ "$out" = 1 ]
}

# One firewall change at a time. The repair timer reads a link's config and rules and acts on
# what it read: that must not interleave with firewall-up/-down from the app or a hook, or it
# could put back the rules of a link that was just stopped or had forwarding turned off. In
# $CONF_DIR, which only root can write. macOS has no flock(1), and no repair timer either.
firewall_lock() {
    command -v flock > /dev/null 2>&1 && [ -d "$CONF_DIR" ] || return 0
    exec 9>> "$CONF_DIR/.wgla-firewall.lock"
    flock -w 30 9 || die "another firewall change is still running"
}

# Only for the link's own interface: forward accepts for any other one (eth0, docker0) would
# open what the host's firewall closed
own_iface_arg() {
    local own=$1
    if [ "$OS" = Darwin ]; then
        own=''
        if [ -f "$RUN_DIR/$1.name" ]; then own=$(head -n 1 "$RUN_DIR/$1.name"); fi
    fi
    [ "$2" = "$own" ] || die "$2 is not the interface of link $1"
}

# ─── Commands ────────────────────────────────────────────────────────────────

command=${1:-}
shift || true

case "$command" in
    version)
        echo "$VERSION"
        ;;
    policy)
        # What this server lets links allow their peers to route (see "Route policy" above)
        args 0 $# "$command"
        for key in allow_default_route allow_own_networks; do
            if policy_allows "$key"; then echo "$key=true"; else echo "$key=false"; fi
        done
        ;;

    # Runtime state (wg)
    interfaces)
        args 0 $# "$command"
        wg show interfaces
        ;;
    dump)
        args 1 $# "$command"; iface_arg "$1"
        wg show "$1" dump
        ;;
    peer-add)
        args 1 $# "$command"; iface_arg "$1"
        TMP=$(mktemp "${TMPDIR:-/tmp}/wgla.XXXXXX")
        read_input "$TMP"
        link_settings "$1"
        validate_peer "$TMP"
        # Through a pipe, like wg-quick does: Ubuntu's AppArmor profile for wg only lets it open
        # files under /etc/wireguard, so it can't read a temp file in /tmp
        # shellcheck disable=SC2002
        cat "$TMP" | wg addconf "$1" /dev/stdin
        ;;
    link-key)
        # A running link's new private key, on stdin (never on a command line), applied live
        args 1 $# "$command"; iface_arg "$1"
        TMP=$(mktemp "${TMPDIR:-/tmp}/wgla.XXXXXX")
        read_input "$TMP"
        key=$(tr -d '\n' < "$TMP")
        [[ $key =~ $re_key ]] || die "invalid private key"
        # Through a pipe, as for peer-add: AppArmor lets wg open files under /etc/wireguard only
        printf '%s\n' "$key" | wg set "$1" private-key /dev/stdin
        ;;
    peer-remove)
        args 2 $# "$command"; iface_arg "$1"; key_arg "$2"
        wg set "$1" peer "$2" remove
        ;;
    peer-ips)
        args 3 $# "$command"; iface_arg "$1"; key_arg "$2"; ips_arg "$3"
        link_settings "$1"
        check_routes "$3"
        # wg takes the list without spaces ("10.0.0.2/32,fd12::2/128")
        wg set "$1" peer "$2" allowed-ips "${3// /}"
        ;;

    # Link configs
    conf-list)
        args 0 $# "$command"
        for file in "$CONF_DIR"/*.conf; do
            [ -e "$file" ] || continue
            name=$(basename "$file" .conf)
            if [[ $name =~ $re_name ]]; then echo "$name"; fi
        done
        ;;
    conf-read)
        args 1 $# "$command"; name_arg "$1"
        file=$(conf_file "$1")
        [ -f "$file" ] || missing "no config for link $1"
        cat "$file"
        ;;
    conf-write)
        args 1 $# "$command"; name_arg "$1"
        install_input "$(conf_file "$1")" validate_conf
        ;;
    conf-check)
        # Whether conf-write would take this config. Nothing is written: for a change that has to
        # stop a link before it can write (an adoption), and for a dry run
        args 1 $# "$command"; name_arg "$1"
        TMP=$(mktemp "${TMPDIR:-/tmp}/wgla.XXXXXX")
        read_input "$TMP"
        validate_conf "$TMP"
        ;;
    conf-delete)
        args 1 $# "$command"; name_arg "$1"
        rm -f "$(conf_file "$1")" "$(adopted_file "$1")"
        ;;

    # Adoption: a config the app didn't write (by hand, by an older API: hooks of its own) gives
    # way to the app's version of it. The new one is checked like any other. The one it replaces
    # is kept beside it until the link runs with the new one (conf-adopt-done), and goes back if
    # it doesn't (conf-adopt-undo). What goes back is only ever what was here: a config with hooks
    # of its own is never the caller's to hand in.
    conf-adopt)
        args 1 $# "$command"; name_arg "$1"
        file=$(conf_file "$1")
        [ -f "$file" ] || missing "no config for link $1"
        TMP=$(mktemp "$CONF_DIR/.wgla.XXXXXX")
        read_input "$TMP"
        validate_conf "$TMP"
        chmod 600 "$TMP"
        rm -f "$(adopted_file "$1")"
        cp "$file" "$(adopted_file "$1")"
        mv -f "$TMP" "$file"
        TMP=''
        ;;
    conf-adopt-undo)
        args 1 $# "$command"; name_arg "$1"
        [ -f "$(adopted_file "$1")" ] || die "no config of link $1 from before an adoption is kept: nothing to put back"
        mv -f "$(adopted_file "$1")" "$(conf_file "$1")"
        ;;
    conf-adopt-done)
        args 1 $# "$command"; name_arg "$1"
        rm -f "$(adopted_file "$1")"
        ;;

    # Client (peer) configs: served to clients, never run here, so only paths are checked
    client-read)
        args 2 $# "$command"; name_arg "$1"; safe_key_arg "$2"
        file=$(client_file "$1" "$2")
        [ -f "$file" ] || missing "no client config $2 for link $1"
        cat "$file"
        ;;
    client-write)
        args 2 $# "$command"; name_arg "$1"; safe_key_arg "$2"
        install_input "$(client_file "$1" "$2")" true
        ;;
    client-delete)
        args 2 $# "$command"; name_arg "$1"; safe_key_arg "$2"
        rm -f "$(client_file "$1" "$2")"
        ;;
    client-delete-all)
        args 1 $# "$command"; name_arg "$1"
        rm -rf "${CONF_DIR:?}/clients/$1"
        ;;
    client-keys)
        # Whose private keys the link's client directory holds, by public key (and nothing but
        # public keys): "stored" the app's way, in a file named by that key, or "legacy" in a
        # client config an older API left there
        args 1 $# "$command"; name_arg "$1"
        for file in "$CONF_DIR/clients/$1"/*.conf; do
            name=${file##*/}
            name=${name%.conf}
            if [ -f "$file" ] && [[ $name =~ $re_safe_key ]]; then
                pub=${name//-/+}
                echo "stored ${pub//_//}="
            fi
        done
        legacy_keys "$1" list
        ;;
    client-import)
        # Those of the link's peers, stored the app's way. Prints the public keys it stored.
        args 1 $# "$command"; name_arg "$1"
        [ -f "$(conf_file "$1")" ] || missing "no config for link $1"
        legacy_keys "$1" import
        ;;

    # Lifecycle
    up)
        args 1 $# "$command"; name_arg "$1"
        [ -f "$(conf_file "$1")" ] || die "no config for link $1"
        if [ "$OS" = Darwin ]; then
            wg-quick up "$(conf_file "$1")"
        else
            systemctl enable --now "wg-quick@$1"
        fi
        ;;
    down)
        # Idempotent: stopping a stopped link succeeds (and on Linux also disables its unit)
        args 1 $# "$command"; name_arg "$1"
        if [ "$OS" = Darwin ]; then
            if [ -f "$RUN_DIR/$1.name" ]; then wg-quick down "$(conf_file "$1")"; fi
        else
            systemctl disable --now "wg-quick@$1"
        fi
        ;;
    resolve)
        # The OS interface of a link: on macOS wg-quick runs it as a fresh utunN
        args 1 $# "$command"; name_arg "$1"
        real=''
        if [ "$OS" = Darwin ] && [ -f "$RUN_DIR/$1.name" ]; then real=$(head -n 1 "$RUN_DIR/$1.name"); fi
        if [[ $real =~ ^utun[0-9]+$ ]]; then echo "$real"; else echo "$1"; fi
        ;;

    # Firewall (also called by the PostUp/PostDown hooks)
    firewall-up)
        args 2 $# "$command"; name_arg "$1"; iface_arg "$2"; own_iface_arg "$1" "$2"
        firewall_lock
        firewall_state "$1"
        firewall_up "$1" "$2"
        ;;
    firewall-check)
        # "ok" or "missing": whether a running link still has the rules its config asks for
        args 2 $# "$command"; name_arg "$1"; iface_arg "$2"; own_iface_arg "$1" "$2"
        firewall_state "$1"
        if firewall_present "$1" "$2"; then echo ok; else echo missing; fi
        ;;
    firewall-repair)
        # Every running link that lost its rules gets them back. For the timer wg:install sets
        # up (as root, every minute); a link whose config can't be read doesn't stop the others.
        args 0 $# "$command"
        # Locked before it looks: what is running and what the configs ask for is read under the
        # lock, so a link stopped (or changed) meanwhile gets its firewall-down after this
        firewall_lock
        running=$(wg show interfaces 2> /dev/null) || running=''
        for iface in $running; do
            link=$(link_of_iface "$iface")
            if [[ $link =~ $re_name ]] && [ -f "$(conf_file "$link")" ]; then
                # In a subshell, which exits on die. `set -e` doesn't apply in a condition, so every
                # failure is an explicit exit, and the success line only follows a success.
                # <4>/<3>: a warning/an error in the journal, where the timer's every run is not
                # worth a line.
                if ! (
                    firewall_state "$link"
                    if firewall_present "$link" "$iface"; then exit 0; fi
                    firewall_up "$link" "$iface" || exit 1
                    echo "<4>wgla-helper: link $link had lost its firewall rules; they are back"
                ); then
                    echo "<3>wgla-helper: link $link is missing its firewall rules, and they could not be put back"
                fi
            fi
        done
        ;;
    firewall-down)
        args 1 $# "$command"; name_arg "$1"
        firewall_lock
        if [ "$OS" = Darwin ]; then firewall_down_darwin "$1"; else firewall_down_linux "$1"; fi
        ;;

    *)
        die "unknown command '$command' (helper version $VERSION). If the app was updated, reinstall the helper: see php artisan wg:help"
        ;;
esac
